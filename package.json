{
  "name": "dsh-warm-ui",
  "version": "0.1.0",
  "description": "暖色调主题 + 输入栏工具行整形：通过 ctx.theme.overrideTokens 叠一层暖色 token，并用一张样式表把输入栏里的第三方控件压扁、对齐 DSH 的克制风格",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node tools/check.mjs",
    "check:browser": "node tools/check.mjs --browser"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "theme",
    "warm",
    "glass"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-theme": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.7-rc.2 <0.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "external": [
        "dsh-warm-shared"
      ]
    }
  }
}
