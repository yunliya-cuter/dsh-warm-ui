{
  "version": 1,
  "title": "dsh-warm-ui 界面契约",
  "howToRead": "这份文件是「UI 应该长什么样」的唯一机器可读版本：静态检查（tools/check.mjs）核对名字/归属，真机探针（tools/check.mjs --browser）核对数字与可见性。改设计先改这里，再改代码。",
  "packages": {
    "dsh-warm-shared": {
      "role": "shared",
      "entry": "preview/shared/lib/client.js",
      "manifest": "preview/shared/package.json",
      "exports": [
        "createStyleInstaller",
        "cssPropertyName"
      ],
      "styleSheets": [],
      "ownerKeys": [],
      "detachedOwnerKeys": [],
      "inLayoutOwnerKeys": [],
      "markers": [],
      "cssVarsFromJs": [],
      "mountHelpers": [
        "installStyleSheet"
      ]
    },
    "dsh-warm-ui": {
      "role": "consumer",
      "entry": "lib/client.js",
      "manifest": "package.json",
      "requires": [
        "dsh-warm-shared"
      ],
      "styleSheets": [
        {
          "name": "base",
          "marker": "data-dsh-warm-ui",
          "cssTemplate": "STYLESHEET",
          "cssVarPrefix": "--wta-"
        },
        {
          "name": "extra",
          "marker": "data-dsh-warm-extra",
          "cssTemplate": "EXTRA_STYLESHEET",
          "cssVarPrefix": "--wta-"
        }
      ],
      "ownerKeys": [
        "glassSvg",
        "optimizerPop",
        "guardNote",
        "collapseChip"
      ],
      "detachedOwnerKeys": [
        "glassSvg",
        "optimizerPop",
        "guardNote"
      ],
      "inLayoutOwnerKeys": [
        "collapseChip"
      ],
      "onDemandOwnerKeys": [
        "guardNote"
      ],
      "markers": [
        "data-dsh-warm-owner",
        "data-dsh-warm-collapse",
        "data-dsh-warm-optimizer-pop",
        "data-dsh-warm-guard-note",
        "data-wta-glass-svg",
        "data-dsh-warm-dpo",
        "data-dsh-warm-bold"
      ],
      "cssVarsFromJs": [
        "--wta-glass-tint-cur"
      ],
      "mountHelpers": [
        "mountDetached",
        "installStyleSheet"
      ]
    },
    "dsh-warm-wallpaper": {
      "role": "consumer",
      "entry": "preview/wallpaper/lib/client.js",
      "manifest": "preview/wallpaper/package.json",
      "requires": [
        "dsh-warm-shared"
      ],
      "styleSheets": [
        {
          "name": "base",
          "marker": "data-dsh-warm-wallpaper-style",
          "cssTemplate": "STYLESHEET",
          "cssVarPrefix": "--wlp-"
        }
      ],
      "ownerKeys": [
        "layer"
      ],
      "detachedOwnerKeys": [
        "layer"
      ],
      "inLayoutOwnerKeys": [],
      "markers": [
        "data-dsh-warm-owner",
        "data-dsh-warm-wallpaper-layer",
        "data-dsh-warm-wallpaper"
      ],
      "cssVarsFromJs": [],
      "mountHelpers": [
        "mountLayer",
        "installStyleSheet"
      ]
    }
  },
  "toolbar": {
    "stateAttribute": "data-dsh-warm-dpo",
    "states": [
      "chip",
      "native",
      "fallback"
    ],
    "chipUniqueness": {
      "selector": ".wti-chip",
      "meaning": "工具行里「优化」胶囊恒为一颗。清扫按**类名**而不是只按归属标记 data-dsh-warm-collapse：标记是后来才加的，页面里可能还留着更早一代造出来的同类节点（没有那个属性，只按属性扫不到），于是和新胶囊并排出现两颗 —— 2026-09-24 用户截图报的就是它。另外只有最新一代实例允许写工具行（换代守卫），否则两个活实例会互相删/塞打架。",
      "measured": "往 .dpo-controls 塞一颗无标记同类节点：计数 1 → 2 并一直保持（复现）；改成按类名清扫后同一动作的结果是恒定 1 颗。"
    },
    "rowHeightPx": 24,
    "rowHeightVar": {
      "package": "dsh-warm-ui",
      "name": "--wta-ctl-h"
    },
    "meaning": {
      "chip": "宽屏：我们的「优化」胶囊在、插件两根滑杆都藏起来",
      "native": "窄屏：插件自己的档位胶囊在、权限滑杆藏起来、我们的胶囊不在",
      "fallback": "认不出插件 DOM：一切原样，我们的胶囊不在"
    }
  },
  "composer": {
    "widthPreferenceKey": "dsh.conversation.contentWidth",
    "contentDefaultCapPx": 920,
    "contentMinPx": 640,
    "edgeBudgetPx": 176,
    "sideClearancePx": 16,
    "invariant": "卡片宽度 = 会话内容宽度 + 32；无偏好时内容宽度 = clamp(680, 列宽 * 0.64, 920)，有偏好时 = clamp(偏好, 640, 列宽 - 176)",
    "measuredAgainst": "dsh-client-ui-conversation/lib/client.js 的 WIDTH_PREF_KEY / resolveContentWidth / uV2eYG_card"
  },
  "glass": {
    "meaning": "液态玻璃：折射 + 边缘光 + 表面反射。**不做动效** —— 玻璃上没有任何随时间变化的位移",
    "targets": [
      "[data-slot=\"conversation.composer.bar\"] [class*=\"_card\"]",
      "[data-slot=\"conversation.input.dock\"] [class*=\"_root\"]"
    ],
    "motion": {
      "state": "none",
      "meaning": "原来这里有一层「流动层」：叠一条随时间变化的低频噪声位移（GLASS_WARP 配方 + 定时器驱动 baseFrequency/scale），叠在折射之上。2026-09-24 按用户要求整层删除（原话：「消除输入框边缘波纹动效」「不要用另一套动效替代」）。删的是实现，不是显示：滤镜图里不再有 feTurbulence/驱动属性，body 上不再有 data-wta-glasswarp，EXTRA_DEFAULTS 里不再有 glassWarp。",
      "codeGuards": [
        "玻璃滤镜图里不得再出现 feTurbulence",
        "body 上不得再出现 data-wta-glasswarp",
        "EXTRA_DEFAULTS 里不得再出现 glassWarp"
      ],
      "measured": "同一张卡片两相位差分（1752×830，Chromium）：壁纸开着时上沿带 5.73；把流动层驱动冻住后仍有 5.43；把壁纸那层藏掉后只剩 0.23。即卡片边缘的「动」绝大部分来自会动的壁纸透过玻璃，玻璃自身那点动才是被删掉的流动层 —— 删掉后壁纸那部分照旧可见（那是壁纸本身，不是玻璃的动效）。"
    }
  },
  "invariants": {
    "documentOverflowPx": 0,
    "styleTagPerSheet": 1,
    "nodePerOwnerKey": 1,
    "unownedStyleTags": 0
  },
  "viewports": {
    "ref": {
      "width": 1280,
      "height": 560,
      "dpr": 1.2
    },
    "wide": {
      "width": 1752,
      "height": 830,
      "dpr": 1.2
    }
  }
}